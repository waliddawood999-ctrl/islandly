{
  "name": "islandly",
  "version": "0.5.0",
  "description": "A Dynamic Island for Windows: music, timers, battery and more in one floating pill.",
  "main": "src/main/bootstrap.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/ics.test.js && node test/updater.test.js && node test/palette.test.js && node test/ai.test.js && node test/releases.test.js",
    "test:smoke": "electron test/electron-smoke.js",
    "test:e2e": "electron test/ui-e2e.js",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "26.18.0"
  },
  "optionalDependencies": {
    "@coooookies/windows-smtc-monitor": "^1.0.12"
  },
  "islandlyBase": 3,
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "adhan": "^4.4.6",
    "koffi": "^2.16.3"
  }
}
