{
  "name": "islandly",
  "version": "0.4.0",
  "description": "A Dynamic Island for Windows: music, timers, battery and more in one floating pill.",
  "main": "src/main/bootstrap.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/run-tests.js",
    "test:smoke": "electron test/electron-smoke.js",
    "test:e2e": "electron test/ui-e2e.js",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "package:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-native.ps1",
    "test:locales": "node test/locales-check.js",
    "test:ci-guards": "node test/ci-guards.test.js"
  },
  "devDependencies": {
    "@fontsource/alexandria": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/readex-pro": "^5.3.0",
    "electron": "^45.1.0",
    "lucide-static": "^1.63.0",
    "motion": "^14.7.1"
  },
  "optionalDependencies": {
    "@coooookies/windows-smtc-monitor": "^1.0.12"
  },
  "islandlyBase": 2,
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "adhan": "^4.4.6",
    "koffi": "^2.16.3"
  }
}
